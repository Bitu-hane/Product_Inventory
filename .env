# Server Configuration
PORT=8080
ENV=development

# PostgreSQL Database (No password required / Trust authentication)
POSTGRES_USER=postgres
POSTGRES_DB=product_inventory
POSTGRES_PORT=5432

# Database Connection URLs for Docker Services (no password)
DB_URL=postgres://postgres@postgres:5432/product_inventory?sslmode=disable
DATABASE_URL=postgres://postgres@postgres:5432/product_inventory?sslmode=disable
